<UserControl
    x:Class="Bim4Everyone.RevitFiltration.Controls.Views.InnerDynamicCategoriesFilterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vms="clr-namespace:Bim4Everyone.RevitFiltration.Controls.ViewModels"
    xmlns:local="clr-namespace:Bim4Everyone.RevitFiltration.Controls.Views"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300"
    x:ClassModifier="internal"
    x:Name="_this"
    d:DataContext="{d:DesignInstance vms:DynamicCategoriesFilterViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="1*"
                MinWidth="200" />
            <ColumnDefinition
                Width="Auto" />
            <ColumnDefinition
                Width="2*"
                MinWidth="200" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Style="{StaticResource CustomBorder}">
            <DockPanel
                LastChildFill="True">
                <Label
                    DockPanel.Dock="Top"
                    Content="{Binding CategoriesHeader}" />
                <local:CategoriesView
                    DataContext="{Binding }" />
            </DockPanel>
        </Border>

        <GridSplitter
            Grid.Column="1"
            Style="{StaticResource CustomGridSplitter}" />

        <Grid
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="1*" />
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style
                            TargetType="RowDefinition">
                            <Setter
                                Property="Height"
                                Value="1*" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding AdditionalContent, ElementName=_this}"
                                    Value="{x:Null}">
                                    <Setter
                                        Property="Height"
                                        Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Style="{StaticResource CustomBorder}">
                <ScrollViewer>
                    <StackPanel>
                        <Label
                            Content="{Binding RootSetHeader}" />
                        <local:SetView
                            DataContext="{Binding RootSet}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0 5 0 0">
                <Border.Style>
                    <Style
                        TargetType="Border"
                        BasedOn="{StaticResource CustomBorder}">
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding AdditionalContent, ElementName=_this}"
                                Value="{x:Null}">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- ContentControl, а не ContentPresenter: последний для UIElement-контента
                     сбрасывает свой DataContext, и контент не получает внешнюю модель представления -->
                <ContentControl
                    Content="{Binding AdditionalContent, ElementName=_this}"
                    DataContext="{Binding AdditionalContentDataContext, ElementName=_this}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
