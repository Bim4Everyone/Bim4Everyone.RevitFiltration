{
  "$schema": "https://github.com/dotnet/docfx/blob/main/schemas/v1.0/schema.json",
  "metadata": [
    {
      "dest": "api",
      "src": [ { "src": "../bin", "files": "Bim4Everyone.**.dll" } ]
    }
  ],
  "build": {
    "content": [
      { "files": [ "toc.yml", "*.md" ] },
      { "files": [ "api/*.yml", "api/*.md" ] },
      { "files": [ "articles/**.md", "articles/**/toc.yml" ] }
    ],
    
    "resource": [
      { "files": [ "images/**" ] }
    ],
    
    "output": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "globalMetadata" :
    {
      "_appName" : "Bim4Everyone.RevitFiltration",
      "_appTitle" : "Bim4Everyone.RevitFiltration",
      "_appFooter" : "Copyright &copy; 2026 Bim4Everyone",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "sitemap": {
      "baseUrl": "https://bim4everyone.github.io/Bim4Everyone.RevitFiltration",
      "priority": 0.8,
      "changefreq": "monthly",
      "fileOptions": {
        "**/articles/**": {
          "priority": 0.8
        },
        "**/api/**": {
          "priority": 0.3
        }
      }
    }
  }
}